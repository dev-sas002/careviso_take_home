# Copy to .env for local development (.env is git-ignored).
# Docker Compose sets these itself; see docker-compose.yml.

# Postgres connection. DB_HOST is empty locally, which means a Unix socket.
DB_HOST=
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=

# Which selection algorithm answers by default: exact_cover (the fast solver)
# or brute_force (the exhaustive reference implementation).
PACKAGE_SELECTION_STRATEGY=exact_cover

# How many sub-problems the exact-cover search may visit before giving up.
PACKAGE_SELECTION_MAX_STATES=200000

# Puma / ActiveRecord pool size.
RAILS_MAX_THREADS=5
