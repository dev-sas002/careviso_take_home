<% content_for :title, @product.name %>

<%= render "shared/page_header",
           title: @product.name,
           subtitle: "Product ##{@product.id}",
           actions: link_to("Back to products", products_path, class: "btn btn-outline-secondary") %>

<div class="card">
  <div class="card-body">
    <dl class="detail-list">
      <dt>In packages</dt>
      <dd><%= render "shared/product_badges", products: @product.packages.map(&:name) %></dd>

      <dt>On orders</dt>
      <dd>
        <% if @product.orders.any? %>
          <%= safe_join(@product.orders.map { |order| link_to("Order ##{order.id}", order) }, ", ") %>
        <% else %>
          <span class="text-muted">—</span>
        <% end %>
      </dd>
    </dl>
  </div>
  <div class="card-footer d-flex gap-2">
    <%= link_to "Edit", edit_product_path(@product), class: "btn btn-sm btn-outline-secondary" %>
    <%= link_to "Delete", @product, method: :delete, class: "btn btn-sm btn-outline-danger",
                data: { confirm: "Delete #{@product.name}?" } %>
  </div>
</div>
