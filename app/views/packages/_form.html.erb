<div class="card form-card">
  <div class="card-body">
    <%= form_for @package do |f| %>
      <%= render "shared/form_errors", record: @package %>

      <div class="mb-3">
        <%= f.label :name, "Package name", class: "form-label" %>
        <%= f.text_field :name, class: "form-control", required: true, autofocus: true %>
      </div>

      <div class="mb-3">
        <%= f.label :product_ids, "Contents", class: "form-label" %>
        <%= f.collection_select :product_ids, @available_products, :id, :name, {},
                                { multiple: true, id: "products-select", class: "form-select", required: true } %>
        <div class="form-text">A package ships all of these products together, every time.</div>
      </div>

      <div class="d-flex gap-2">
        <%= f.submit class: "btn btn-primary" %>
        <%= link_to "Cancel", packages_path, class: "btn btn-outline-secondary" %>
      </div>
    <% end %>
  </div>
</div>
