<% content_for :title, "Order ##{@order.id}" %>

<%= render "shared/page_header",
           title: "Order ##{@order.id}",
           subtitle: "#{pluralize(@order.products.size, 'product')} ordered",
           actions: link_to("Back to orders", orders_path, class: "btn btn-outline-secondary") %>

<div class="card mb-4">
  <div class="card-header">Ordered products</div>
  <div class="card-body">
    <%= render "shared/product_badges", products: @order.products %>
  </div>
</div>

<div class="card shipment-card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span>Optimal shipment</span>
    <span class="text-muted small">strategy: <%= selection_strategy_name %></span>
  </div>

  <div class="card-body">
    <% if @shipment_error.present? %>
      <div class="alert alert-warning mb-0"><%= @shipment_error %></div>
    <% elsif @shipment_packages.any? %>
      <p class="shipment-summary">
        <strong><%= pluralize(@shipment_packages.size, "package") %></strong>
        ship <strong><%= pluralize(@order.products.size, "product") %></strong> exactly —
        nothing missing, nothing surplus.
      </p>

      <ol class="shipment-list">
        <% @shipment_packages.each do |package| %>
          <li>
            <%= link_to package.name, package, class: "shipment-name" %>
            <%= render "shared/product_badges", products: package.products %>
          </li>
        <% end %>
      </ol>
    <% else %>
      <div class="alert alert-warning mb-0">
        <p class="mb-1 fw-semibold">No exact shipment exists for this order.</p>
        <p class="mb-0">
          Every combination of packages either misses a product or adds one that was not
          ordered. Adding a package that holds the missing products exactly would fix it.
        </p>
      </div>
    <% end %>
  </div>

  <div class="card-footer text-muted small">
    Same answer as
    <code><%= link_to "GET /select_optimal_packages?order_id=#{@order.id}",
                      select_optimal_packages_path(order_id: @order.id) %></code>
  </div>
</div>

<div class="d-flex gap-2 mt-4">
  <%= link_to "Edit order", edit_order_path(@order), class: "btn btn-sm btn-outline-secondary" %>
  <%= link_to "Delete order", @order, method: :delete, class: "btn btn-sm btn-outline-danger",
              data: { confirm: "Delete order ##{@order.id}?" } %>
</div>
