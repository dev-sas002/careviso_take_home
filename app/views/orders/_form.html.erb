<div class="card form-card">
  <div class="card-body">
    <%= form_for @order do |f| %>
      <%= render "shared/form_errors", record: @order %>

      <div class="mb-3">
        <%= f.label :product_ids, "Products", class: "form-label" %>
        <%= f.collection_select :product_ids, @available_products, :id, :name, {},
                                { multiple: true, id: "products-select", class: "form-select", required: true } %>
        <div class="form-text">Each product is shipped once; duplicates are ignored.</div>
      </div>

      <div class="d-flex gap-2">
        <%= f.submit class: "btn btn-primary" %>
        <%= link_to "Cancel", orders_path, class: "btn btn-outline-secondary" %>
      </div>
    <% end %>
  </div>
</div>
